#!/usr/bin/env python3

from lib.config import Config
from lib.connection import Connection
from lib.models import Models
from lib.endpoint import Endpoint


def main():
  config = Config()

  connection = Connection(
    config
  )

  models = Models(
    config,
    connection
  )

  endpoint = Endpoint(
    config,
    models
  )

  endpoint.run_daemon()


if __name__ == "__main__":
  main()
